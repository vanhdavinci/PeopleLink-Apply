# Optional overrides (defaults work for local use)
# PEOPLELINK_DB_PATH=data/peoplelink.db
# PEOPLELINK_SUBMIT_DELAY_MS=800
# PEOPLELINK_LOCATION_API_BASE=https://api_adhoc.plsvn.com
# PEOPLELINK_LOCATION_AUTH=Basic FlexibleProjects:0:0
# Login — 1 account:
# PEOPLELINK_AUTH_USERNAME=kimngaan
# PEOPLELINK_AUTH_PASSWORD=230426
# Login — seed vào bảng auth_users (hash). Secrets/env vẫn được sync khi init DB.
# PEOPLELINK_AUTH_USERS={"ngan.btk":"KimNgaan1202","vietanh":"VietAnh123","admin":"passwordAdmin"}
# Session timeout (giờ). Token cất trong cookie browser; hết hạn sau N giờ.
# PEOPLELINK_AUTH_SESSION_HOURS=4
# PEOPLELINK_AUTH_SECRET=doi-chuoi-bi-mat-cua-ban
# Portal session cookie for project sync (browser DevTools → Application → Cookies)
# PEOPLELINK_PORTAL_COOKIE=.AspNetCore.Cookies=...; other=...
