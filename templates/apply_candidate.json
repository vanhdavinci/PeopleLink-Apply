{
  "endpoint": "POST /ProjectHeadcount/Candidate_ApplyRequest_v2",
  "content_type": "multipart/form-data",
  "notes": [
    "Apply URL paste: https://recruit.peoplelinkvietnam.com/ProjectHeadcount/ApplyRequest/{id}",
    "Path {id} → HeadcountReqRecruiterID (+ referer) — ví dụ 2239",
    "ProjectHeadcountID lấy từ UI chọn dự án lúc đẩy (ví dụ 176) — KHÔNG lấy từ ApplyRequest URL / Excel",
